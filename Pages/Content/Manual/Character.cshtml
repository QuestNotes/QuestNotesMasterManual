@page
@model QuestNotesWebRazor.Pages.Content.Manual.CharacterModel
@{
    Layout = "~/Pages/Content/Manual/_Layout.cshtml";
    ViewData["Title"] = "マニュアル　キャラクター" + TextResource.BaseTitle;
}
<div>
    <h2 class="boarder">キャラクター</h2>
    <div class="hideInTouch">
        <p>キャラクター編集ウィンドウではいくつかのタブでデータを設定できます。 </p>

        <div class="boarder">基本</div>
        <p>
            基本タブでは、基本情報を設定できます。><br />
            <img src="/image/manual/11-1.png" /><br />
            <ul>
                <li>
                    ID - キャラクターに自動的に割り振られる ID です。ボード上にオブジェクトとしてキャラクターを配置するとき、 このID
                    を指定することで行います。
                </li>
                <li>アイコン - サムネイルアイコンです。素材ファイルやインターネット上のファイルを選択できます。 </li>
                <li>名前 - 名前を設定します。 </li>
                <li>説明 - 説明を入力します。 </li>
                <li>タイプ - 種族を設定します。 </li>
            </ul>

        </p>

        <div class="boarder">ステータス</div>
        <p>
            ステータスタブでは能力を設定できます。<br />
            <img src="/image/manual/11-2.png" /><br />

            <ul>
                <li>レベル - レベルを設定します。 </li>
                <li>HP - 最大 HP を設定します。 </li>
                <li>SP - 最大 SP を設定します。 </li>
                <li>Will - 最大 Will を設定します。 </li>
                <li>AP - 最大 AP を設定します。 </li>
                <li>筋力/STR - 力や強さを設定します。重いものを持ち上げたり、攻撃力に使用する能力値です。</li>
                <li>知力/INT - 知性の高さを設定します。物事への知識を持っているかや、魔法攻撃力に使用する能力値です。</li>
                <li>器用/DEX - 器用さを設定します。精密な作業や、命中判定に使用する能力値です。</li>
                <li>体力/CON - 体の頑強さを設定します。衝撃に耐えたり、防御力に使用する能力値です。 </li>
                <li>感覚/SEN - 感覚の鋭さを設定します。違和感を発見したり、魔法防御力に使用する能力値です。 </li>
                <li>敏捷/AGI - 運動能力を設定します。すばやい動作や、回避判定に使用する能力値です。 </li>
                <li>攻撃/ATK - 物理ダメージの補正を設定します。 </li>
                <li>魔攻/MATK - 魔法ダメージの補正を設定します。 </li>
                <li>命中/HIT - 命中判定の補正を設定します。 </li>
                <li>回避./FLEE - 回避判定の補正を設定します。 </li>
                <li>抵抗/RESI - 抵抗判定の補正を設定します。</li>
                <li>範囲/RANGE - 通常攻撃の届く範囲を設定します。</li>
                <li>防御/DEF - 物理防御力の補正を設定します。 </li>
                <li>魔防/MDEF - 魔法防御力の補正を設定します。 </li>
                <li>移動/Move - 移動できるチップ数を設定します。</li>
                <li>ダメージタイプ - 通常攻撃のダメージの種類を設定します。</li>
                <li>ダメージ属性 - 通常攻撃のダメージの属性を設定します。</li>
            </ul>

        </p>

        <div class="boarder">属性補正</div>
        <p>
            属性補正タブでは属性への耐性を設定できます。<br />
            <img src="/image/manual/11-3.png" /><br />
            属性は以下の中から選択できます。<br />

            <ul>
                <li>なし - 修整なし</li>
                <li>弱点 - ダメージ1.5倍</li>
                <li>耐性 -　ダメージ半減</li>
                <li>無効 -　ダメージ0</li>
            </ul>

        </p>

        <div class="boarder">イラスト</div>
        <p>
            イラストタブでは詳細イラストを設定できます。<br />
            <img src="/image/manual/11-4.png" /><br />
            イラストは素材ファイルやインターネット上のファイルを選択できます。
        </p>

        <div class="boarder">作戦</div>
        <p>
            作戦タブでは行動を設定できます。<br />
            <img src="/image/manual/11-5.png" /><br />
            サイドは、敵や味方のどちらとして扱うかを決定します。<br />
            作戦の設定については、<a href="Ai">作戦</a>を参照してください。

        </p>
        <div class="boarder">スキル</div>
        <p>
            スキルタブではキャラクターが習得しているスキルを設定できます。<br />
            <img src="/image/manual/11-6.png" /><br />
            ここで追加したスキルを作戦で設定できるようになります。
        </p>
    </div>
    <div class="showInTouch">
        <img src="/image/manual/touch/11-1.png" /><br />
        <ul>
